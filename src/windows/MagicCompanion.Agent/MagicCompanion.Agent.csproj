<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SupperScreen.ico</ApplicationIcon>
    <AssemblyName>SupperScreen</AssemblyName>
    <Version>0.21.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MagicCompanion.PlatformChecks" />
    <Resource Include="Assets/SupperScreen.ico" />
    <ProjectReference Include="../../core/MagicCompanion.Core/MagicCompanion.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
