{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magiccompanion.local/protocol/todo-snapshot",
  "type": "object",
  "required": [
    "revision",
    "updatedAt",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "completed",
          "sortOrder"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "completed": {
            "type": "boolean"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 0
          },
          "color": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "textColor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "backgroundColor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    }
  }
}
