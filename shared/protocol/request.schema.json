{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magiccompanion.local/protocol/request",
  "type": "object",
  "required": [
    "protocolVersion",
    "messageType",
    "sessionId",
    "deviceId",
    "requestId",
    "action",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "messageType": {
      "const": "request"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "payload": {
      "type": "object"
    }
  }
}
